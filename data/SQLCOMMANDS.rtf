\f0\fs24 \cf0 CREATE DATABASE testlogin;\
CREATE TABLE cartItems (\
    cartItemsId int(11) PRIMARY KEY AUTO_INCREMENT NOT NULL,\
    shoppingSessionId int(11) UNIQUE KEY NOT NULL,\
    productId int(11) UNIQUE KEY NOT NULL,\
    cartItemQuantity int(11) NOT NULL,\
    cartItemCreatedDate DATETIME DEFAULT CURRENT_TIMESTAMP)\
    ;\
CREATE TABLE discountCode (\
    discountCodeId int(11) PRIMARY KEY AUTO_INCREMENT NOT NULL,\
    discountCodeForCheckout varchar(128) UNIQUE KEY NOT NULL,\
    discountPercentage int(3) NOT NULL,\
    createdDate DATETIME DEFAULT CURRENT_TIMESTAMP,\
    expiryDate DATETIME \
    );\
CREATE TABLE orderDetails (\
    orderDetailsId int(11) PRIMARY KEY AUTO_INCREMENT NOT NULL,\
    userId int(11) NOT NULL,\
    orderTotal float(6) NOT NULL,\
    orderTaxTotal float(6) NOT NULL,\
    shippingDate DATETIME DEFAULT CURRENT_TIMESTAMP,\
    billingDate DATETIME DEFAULT CURRENT_TIMESTAMP\
    );\
CREATE TABLE products (\
    productId int(11) PRIMARY KEY AUTO_INCREMENT NOT NULL,\
    productName varchar(128) NOT NULL,\
    productPrice float(6) NOT NULL,\
    category varchar(128) NOT NULL,\
    unitsInStock int(11) NOT NULL,\
    averageRating float(6) NOT NULL, \
    size varchar(2) NOT NULL\
    );\
\
CREATE TABLE admins (\
    adminId INT NOT NULL PRIMARY KEY AUTO_INCREMENT,\
    adminUsername VARCHAR(50) NOT NULL UNIQUE,\
    adminPassword VARCHAR(255) NOT NULL,\
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\
    lastLoggedOn DATETIME DEFAULT CURRENT_TIMESTAMP\
);\
CREATE TABLE shoppingSession (\
    shoppingSessionId int(11) PRIMARY KEY AUTO_INCREMENT NOT NULL,\
    userId INT(11) UNIQUE KEY NOT NULL,\
    shoppingSessionTotal float(6) NOT NULL,\
    shoppingSessionCreatedDate DATETIME DEFAULT CURRENT_TIMESTAMP,\
    discountCodeId int(11) UNIQUE KEY NOT NULL\
    );\
CREATE TABLE users (\
    userId INT NOT NULL PRIMARY KEY AUTO_INCREMENT,\
    userUsername VARCHAR(50) NOT NULL UNIQUE,\
    userPassword VARCHAR(255) NOT NULL,\
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP\
);\
